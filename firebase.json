{
  "hosting": {
    "public": "web/dist",
    "predeploy": "npm run build",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/.git/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "transferApi",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "sendsnippet-v2"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": [
    {
      "target": "transfers",
      "rules": "storage.rules"
    },
    {
      "target": "legacy",
      "rules": "storage-legacy.rules"
    }
  ],
  "emulators": {
    "auth": {
      "port": 9189
    },
    "functions": {
      "port": 5081
    },
    "firestore": {
      "port": 8187
    },
    "storage": {
      "port": 9198
    },
    "hosting": {
      "port": 5075
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
